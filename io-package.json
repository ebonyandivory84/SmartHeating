{
  "common": {
    "name": "smartheating",
    "version": "0.1.6",
    "news": {
      "0.1.6": {
        "en": "Add dark scrollable settings, complete project documentation and a read-only dashboard link",
        "de": "Dunkle scrollbare Einstellungen, vollständige Projektdokumentation und read-only Dashboard-Link ergänzen"
      },
      "0.1.5": {
        "en": "Load configuration through the official ioBroker Admin 7 GenericApp lifecycle",
        "de": "Konfiguration über den offiziellen GenericApp-Lebenszyklus von ioBroker Admin 7 laden"
      },
      "0.1.4": {
        "en": "Use the Admin 7 compatible React 18 and adapter-react-v5 configuration stack",
        "de": "Admin-7-kompatiblen React-18-/adapter-react-v5-Konfigurationsstack verwenden"
      },
      "0.1.3": {
        "en": "Fix loading adapter configuration on real ioBroker admin connections",
        "de": "Laden der Adapterkonfiguration auf realen ioBroker-Admin-Verbindungen korrigieren"
      },
      "0.1.2": {
        "en": "Exclude deliberately unmapped optional vcontrold signals from the missing-history action list",
        "de": "Bewusst noch nicht gemappte optionale vcontrold-Signale aus der Liste aktivierbarer Historisierungen ausschließen"
      },
      "0.1.1": {
        "en": "Declare adapter states as instance objects and support the installed Node.js 20 LTS runtime",
        "de": "Adapter-States korrekt als Instanzobjekte deklarieren und die installierte Node.js-20-LTS-Laufzeit unterstützen"
      },
      "0.1.0": {
        "en": "Initial observe/shadow release with contextual planning and InfluxDB readiness matrix",
        "de": "Erste Observe-/Shadow-Version mit kontextabhängiger Planung und InfluxDB-Readiness-Matrix"
      }
    },
    "titleLang": {
      "en": "Smart Heating",
      "de": "Smart Heating"
    },
    "desc": {
      "en": "Context-aware, explainable energy planner for heat pump, domestic hot water, PV and battery systems",
      "de": "Kontextabhängiger, erklärbarer EnergyPlanner für Wärmepumpe, Warmwasser, PV und Batterie"
    },
    "authors": ["ebonyandivory84"],
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    },
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "main": "build/main.js",
    "icon": "smartheating.svg",
    "enabled": true,
    "extIcon": "",
    "readme": "https://github.com/ebonyandivory84/SmartHeating/blob/main/README.md",
    "loglevel": "info",
    "type": "energy",
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "messagebox": true,
    "adminUI": {
      "config": "materialize"
    },
    "docs": {
      "de": "PROJECT_DOCUMENTATION.md",
      "en": "PROJECT_DOCUMENTATION.md"
    },
    "localLinks": {
      "dashboard": {
        "link": "%web_protocol%://%ip%:%web_port%/adapter/smartheating/dashboard.html?instance=smartheating.%instance%",
        "name": {
          "de": "SmartHeating-Dashboard öffnen",
          "en": "Open SmartHeating dashboard"
        },
        "description": {
          "de": "Read-only Übersicht für Planung, Lernen, Datenqualität und vcontrold-Migration",
          "en": "Read-only overview of planning, learning, data quality and vcontrold migration"
        },
        "icon": "smartheating.svg",
        "intro": true,
        "order": 10
      }
    },
    "dependencies": [
      {
        "js-controller": ">=7.0.0"
      }
    ]
  },
  "native": {
    "operationMode": "observe",
    "scheduleIntervalMinutes": 15,
    "planningHorizonHours": 36,
    "influxInstance": "influxdb.0",
    "historyLookbackDays": 30,
    "expertMode": false,
    "controlEnabled": false,
    "batteryCapacityKWh": 20,
    "batteryMinimumSocPercent": 5,
    "batteryChargeEfficiency": 0.87,
    "batteryDischargeEfficiency": 0.995,
    "maximumPlanningPowerKW": 12,
    "dhwComfortMinimumC": 37,
    "dhwNormalTargetC": 50,
    "dhwTemp2TargetC": 60,
    "indoorComfortMinimumC": 20.5,
    "minimumHeatingMinutes": 60,
    "overrideUntil": "",
    "overrideMode": "none",
    "learningEnabled": true,
    "recencyHalfLifeDays": 90,
    "minimumLearningSamples": 18,
    "driftMinimumSamples": 12,
    "driftRelativeBiasThreshold": 0.08,
    "outlierZScore": 3.5,
    "pvPowerState": "ekd-solar.0.friendly.leistung_pv_aktuell",
    "housePowerState": "ekd-solar.0.friendly.hausverbrauch_aktuell",
    "gridPowerState": "ekd-solar.0.friendly.netzleistung_signed_w",
    "batteryPowerState": "ekd-solar.0.friendly.batterieleistung_signed_w",
    "batterySocState": "ekd-solar.0.friendly.ladezustand_akku",
