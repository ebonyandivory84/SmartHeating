    "historicalBatteryDischargeState": "0_userdata.0.SolarPower.entladeleistung_akku",
    "dhwTemperatureState": "viessmannapi.0.299550.0.features.heating.dhw.sensors.temperature.dhwCylinder.properties.value.value",
    "dhwNormalTargetState": "viessmannapi.0.299550.0.features.heating.dhw.temperature.main.properties.value.value",
    "dhwTemp2TargetState": "viessmannapi.0.299550.0.features.heating.dhw.temperature.temp2.properties.value.value",
