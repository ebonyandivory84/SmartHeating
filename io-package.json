    { "_id": "status.readinessScore", "type": "state", "common": { "name": "Readiness score", "type": "number", "role": "value", "unit": "%", "read": true, "write": false, "min": 0, "max": 100 }, "native": {} },
    { "_id": "status.summary", "type": "state", "common": { "name": "Readiness summary", "type": "string", "role": "json", "read": true, "write": false }, "native": {} },
