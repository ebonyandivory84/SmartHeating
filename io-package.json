    { "_id": "status.lastRun", "type": "state", "common": { "name": "Last planning run", "type": "string", "role": "date", "read": true, "write": false }, "native": {} },
    { "_id": "status.lastError", "type": "state", "common": { "name": "Last error", "type": "string", "role": "text", "read": true, "write": false }, "native": {} },
