{
  "name": "iobroker.smartheating",
  "version": "0.1.6",
  "description": "Context-aware energy planner for heat pump, domestic hot water, PV and battery systems",
  "author": "ebonyandivory84",
  "license": "MIT",
  "homepage": "https://github.com/ebonyandivory84/SmartHeating",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebonyandivory84/SmartHeating.git"
  },
  "bugs": {
    "url": "https://github.com/ebonyandivory84/SmartHeating/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE",
    "README.md",
    "PROJECT_DOCUMENTATION.md"
  ],
  "scripts": {
    "clean": "rimraf build build-test admin/assets admin/index_m.html admin/dashboard.html",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:tests": "rimraf build-test && tsc -p tsconfig.test.json",
    "build:admin": "vite build",
    "build": "npm run clean && npm run build:backend && npm run build:admin",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p admin-src/tsconfig.json",
    "test": "npm run build:backend && npm run build:tests && node --test build-test/lib/*.test.js",
    "test:all": "npm run check && npm test && npm run build:admin",
    "watch:backend": "tsc -p tsconfig.build.json --watch",
    "watch:admin": "vite",
    "release": "release-script"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.3.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.1.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.1.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@iobroker/adapter-react-v5": "7.7.1",
    "@iobroker/types": "^7.1.1",
    "@mui/icons-material": "^6.4.12",
    "@mui/material": "^6.4.12",
    "@types/node": "^22.19.15",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.1.5"
  }
}
